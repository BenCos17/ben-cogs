msgid "FAA status alert channel set to {channel}"
msgstr "Canalis monitionum status FAA ad {channel} constitutus est"

#: commands\admin.py:119
msgid "FAA status alert channel cleared. No more FAA change notifications will be sent."
msgstr "Canalis monitionum mutationum status FAA deletus est. Nulla amplius notificatio de mutationibus FAA mittetur."

#: commands\admin.py:133
msgid "FAA status alert role set to {role}"
msgstr "Munus monitionum status FAA ad {role} constitutum est"

#: commands\admin.py:144
msgid "FAA status alert role cleared."
msgstr "Munus monitionum status FAA deletum est."

#: commands\admin.py:168
msgid "FAA alert cooldown set to {seconds} seconds."
msgstr "Intervallum exspectationis monitionum FAA ad {seconds} secundas constitutum est."

#: commands\admin.py:170
msgid "FAA alert cooldown set to {minutes} minutes."
msgstr "Intervallum exspectationis monitionum FAA ad {minutes} minuta constitutum est."

#: commands\admin.py:172
msgid "Invalid duration. Use a number, '5m', or '30s'."
msgstr "Duratio invalida. Utere numero, '5m', aut '30s'."

#: commands\admin.py:176
msgid "Current FAA alert cooldown is {seconds} seconds."
msgstr "Nunc intervallum exspectationis monitionum FAA est {seconds} secunda."

#: commands\admin.py:178
msgid "Current FAA alert cooldown is {minutes} minutes."
msgstr "Nunc intervallum exspectationis monitionum FAA est {minutes} minuta."

