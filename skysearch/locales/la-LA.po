msgid "Invalid ICAO Code"
msgstr "Codex ICAO invalidus"

#: commands\aircraft.py:846
msgid "Invalid Aircraft Type"
msgstr "Genus aircrafti invalidum"

#: commands\aircraft.py:847
msgid "Unknown type: **{type}**\n\n"
"Available types: {types}"
msgstr "Genus ignotum: **{type}**\n\n"
"Genera praesto: {types}"

#: commands\aircraft.py:859
msgid "Invalid Squawk Code"
msgstr "Codex Squawk invalidus"

#: commands\aircraft.py:860
msgid "Squawk code must be 4 digits (e.g., 7700)."
msgstr "Codex squawk 4 digitos habere debet (ex. 7700)."

