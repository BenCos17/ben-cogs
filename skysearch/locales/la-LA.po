#: commands\aircraft.py:794 utils\add_to_watchlist_view.py:79
msgid "Add to Watchlist"
msgstr "Ad indicem observandum adde"

#: commands\aircraft.py:795
msgid "Add aircraft or types to watch and get notified when they're active."
msgstr "Adde aircrafta aut genera ad observandum et notificationes accipe cum activa sunt."

#: commands\aircraft.py:798 commands\aircraft.py:903
msgid "Usage"
msgstr "Usus"

#: commands\aircraft.py:798
msgid "`watchlist add <type> <value>`"
msgstr ""

#: commands\aircraft.py:800 commands\aircraft.py:905
msgid "Types"
msgstr "Genera"

#: commands\aircraft.py:801
msgid "• `icao` - Aircraft by hex code (6 hex digits)\n"
"• `type` - Watch aircraft category\n"
"• `callsign` - Watch flight number\n"
"• `reg` - Watch registration/tail number\n"
"• `squawk` - Watch squawk code"
msgstr "• `icao` - Aircraft per codicem hexadecimale (6 digiti hexadecimales)\n"
"• `type` - Categoriam aircraftorum observa\n"
"• `callsign` - Numerum volatus observa\n"
"• `reg` - Numerum registrationis/caudae observa\n"
"• `squawk` - Codicem squawk observa"

#: commands\aircraft.py:805
msgid "Aircraft types"
msgstr "Genera aircraftorum"

#: commands\aircraft.py:810
msgid "Examples"
msgstr "Exempla"

#: commands\aircraft.py:811
msgid "• `watchlist add icao A2F41D`\n"
"• `watchlist add type military`\n"
"• `watchlist add callsign UNITED123`\n"
"• `watchlist add reg N814AK`\n"
"• `watchlist add squawk 7700`"
msgstr ""

#: commands\aircraft.py:824
msgid "Invalid Type"
msgstr "Genus invalidum"

#: commands\aircraft.py:825
msgid "Type must be one of: {types}"
msgstr "Genus unum ex his esse debet: {types}"

