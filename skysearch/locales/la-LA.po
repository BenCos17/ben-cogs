msgid "Invalid duration format. Use a number (e.g. '5'), minutes ('5m'), or seconds ('30s')"
msgstr "Forma durationis invalida. Utere numero (ex. '5'), minutis ('5m'), aut secundis ('30s')."

#: commands\admin.py:98
msgid "Current emergency alert cooldown is {seconds} seconds."
msgstr "Nunc intervallum exspectationis monitionum urgentium est {seconds} secunda."

#: commands\admin.py:100
msgid "Current emergency alert cooldown is {minutes} minutes."
msgstr "Nunc intervallum exspectationis monitionum urgentium est {minutes} minuta."

