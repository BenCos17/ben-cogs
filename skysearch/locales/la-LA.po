msgid "Alert role set to {role}"
msgstr "Munus monitionum ad {role} constitutum est"

#: commands\admin.py:56
msgid "Alert role cleared. No more role mentions will be made."
msgstr "Munus monitionum deletum est. Nulla amplius mentio muneris fiet."

#: commands\admin.py:85 commands\admin.py:164
msgid "Cooldown must be a positive number."
msgstr "Intervallum exspectationis numerus positivus esse debet."

#: commands\admin.py:90
msgid "Emergency alert cooldown set to {seconds} seconds."
msgstr "Intervallum exspectationis monitionum urgentium ad {seconds} secundas constitutum est."

#: commands\admin.py:92
msgid "Emergency alert cooldown set to {minutes} minutes."
msgstr "Intervallum exspectationis monitionum urgentium ad {minutes} minuta constitutum est."

