msgid "Remove aircraft or types from your watchlist."
msgstr "Aircrafta aut genera ex indice tuo observando remove."

#: commands\aircraft.py:903
msgid "`watchlist remove <type> <value>`"
msgstr ""

#: commands\aircraft.py:906
msgid "• `icao` - Remove by aircraft hex code\n"
"• `type` - Remove aircraft type\n"
"• `callsign` - Remove by flight number\n"
"• `reg` - Remove by registration\n"
"• `squawk` - Remove by squawk code"
msgstr "• `icao` - Remove per codicem hexadecimale aircrafti\n"
"• `type` - Remove genus aircrafti\n"
"• `callsign` - Remove per numerum volatus\n"
"• `reg` - Remove per registrationem\n"
"• `squawk` - Remove per codicem squawk"

#: commands\aircraft.py:921
msgid "✅ Removed"
msgstr "✅ Remotum"

#: commands\aircraft.py:921
msgid "❌ Not Found"
msgstr "❌ Non inventum"

#: commands\aircraft.py:938 commands\aircraft.py:984
msgid "Watchlist Empty"
msgstr "Index observandus vacuus"

#: commands\aircraft.py:939
msgid "Your watchlist is empty.\n\n"
"Use `{prefix}aircraft watchlist add <type> <value>` to add items.\n\n"
"Example: `{prefix}aircraft watchlist add type military`"
msgstr "Index tuus observandus vacuus est.\n\n"
"Utere `{prefix}aircraft watchlist add <type> <value>` ad res addendas.\n\n"
"Exemplum: `{prefix}aircraft watchlist add type military`"

#: commands\aircraft.py:947
msgid "Your Watchlist"
msgstr "Index tuus observandus"

#: commands\aircraft.py:948
msgid "You are watching **{count}** items:"
msgstr "Observas **{count}** res:"

#: commands\aircraft.py:969
msgid "None"
msgstr "Nihil"

#: commands\aircraft.py:973
msgid "Use `{prefix}aircraft watchlist status` for detailed status."
msgstr "Utere `{prefix}aircraft watchlist status` ad statum accuratiorem videndum."

#: commands\aircraft.py:985
msgid "Your watchlist is empty."
msgstr "Index tuus observandus vacuus est."

#: commands\aircraft.py:1012
