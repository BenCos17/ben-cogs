#: commands\admin.py:19
#, docstring
msgid "Admin-related commands for SkySearch."
msgstr "Mandata administrativa ad SkySearch pertinentia."

#: commands\admin.py:29
msgid "Alert channel set to {channel}"
msgstr "Canalis monitionum ad {channel} constitutus est"

#: commands\admin.py:37
msgid "Alert channel cleared. No more alerts will be sent."
msgstr "Canalis monitionum deletus est. Nulla amplius monitio mittetur."

