msgid "Emergency alert cooldown set to {seconds} seconds."
msgstr "Wachttijd voor noodwaarschuwingen ingesteld op {seconds} seconden."

#: commands\admin.py:92
msgid "Emergency alert cooldown set to {minutes} minutes."
msgstr "Wachttijd voor noodwaarschuwingen ingesteld op {minutes} minuten."

#: commands\admin.py:94
msgid "Invalid duration format. Use a number (e.g. '5'), minutes ('5m'), or seconds ('30s')"
msgstr "Ongeldig tijdsduurformaat. Gebruik een getal (bijv. '5'), minuten ('5m') of seconden ('30s')"

#: commands\admin.py:98
msgid "Current emergency alert cooldown is {seconds} seconds."
msgstr "De huidige wachttijd voor noodwaarschuwingen is {seconds} seconden."

#: commands\admin.py:100
msgid "Current emergency alert cooldown is {minutes} minutes."
msgstr "De huidige wachttijd voor noodwaarschuwingen is {minutes} minuten."

#: commands\admin.py:108
msgid "FAA status alert channel set to {channel}"
msgstr "FAA-statuswaarschuwingskanaal ingesteld op {channel}"

#: commands\admin.py:119
msgid "FAA status alert channel cleared. No more FAA change notifications will be sent."
msgstr "FAA-statuswaarschuwingskanaal gewist. Er worden geen FAA-wijzigingsmeldingen meer verzonden."

#: commands\admin.py:133
msgid "FAA status alert role set to {role}"
msgstr "FAA-statuswaarschuwingsrol ingesteld op {role}"

#: commands\admin.py:144
msgid "FAA status alert role cleared."
msgstr "FAA-statuswaarschuwingsrol gewist."

#: commands\admin.py:168
msgid "FAA alert cooldown set to {seconds} seconds."
msgstr "FAA-waarschuwingswachttijd ingesteld op {seconds} seconden."

#: commands\admin.py:170
msgid "FAA alert cooldown set to {minutes} minutes."
msgstr "FAA-waarschuwingswachttijd ingesteld op {minutes} minuten."

#: commands\admin.py:172
msgid "Invalid duration. Use a number, '5m', or '30s'."
msgstr "Ongeldige tijdsduur. Gebruik een getal, '5m' of '30s'."

#: commands\admin.py:176
msgid "Current FAA alert cooldown is {seconds} seconds."
msgstr "De huidige FAA-waarschuwingswachttijd is {seconds} seconden."

#: commands\admin.py:178
msgid "Current FAA alert cooldown is {minutes} minutes."
msgstr "De huidige FAA-waarschuwingswachttijd is {minutes} minuten."

