msgid "No Aircraft Found"
msgstr "Geen vliegtuigen gevonden"

#: commands\aircraft.py:605
msgid "No aircraft found within {radius} nautical miles of the specified location."
msgstr "Geen vliegtuigen gevonden binnen {radius} zeemijl van de opgegeven locatie."

