msgstr "Geen antwoord van de API."

#: commands\aircraft.py:794 utils\add_to_watchlist_view.py:79
msgid "Add to Watchlist"
msgstr "Toevoegen aan volglijst"

#: commands\aircraft.py:795
msgid "Add aircraft or types to watch and get notified when they're active."
msgstr "Voeg vliegtuigen of typen toe om te volgen en ontvang een melding wanneer ze actief zijn."

#: commands\aircraft.py:798 commands\aircraft.py:903
msgid "Usage"
msgstr "Gebruik"

#: commands\aircraft.py:798
msgid "`watchlist add <type> <value>`"
msgstr "`watchlist add <type> <waarde>`"

#: commands\aircraft.py:800 commands\aircraft.py:905
msgid "Types"
msgstr "Typen"

#: commands\aircraft.py:801
msgid "• `icao` - Aircraft by hex code (6 hex digits)\n"
"• `type` - Watch aircraft category\n"
"• `callsign` - Watch flight number\n"
"• `reg` - Watch registration/tail number\n"
"• `squawk` - Watch squawk code"
msgstr "• `icao` - Vliegtuig op hex-code (6 hex-cijfers)\n"
"• `type` - Vliegtuigcategorie volgen\n"
"• `callsign` - Vluchtnummer volgen\n"
"• `reg` - Registratie/rompnummer volgen\n"
"• `squawk` - Squawk-code volgen"

#: commands\aircraft.py:805
msgid "Aircraft types"
msgstr "Vliegtuigtypen"

#: commands\aircraft.py:810
msgid "Examples"
msgstr "Voorbeelden"

#: commands\aircraft.py:811
msgid "• `watchlist add icao A2F41D`\n"
"• `watchlist add type military`\n"
"• `watchlist add callsign UNITED123`\n"
"• `watchlist add reg N814AK`\n"
"• `watchlist add squawk 7700`"
msgstr ""

#: commands\aircraft.py:824
msgid "Invalid Type"
msgstr "Ongeldig type"

#: commands\aircraft.py:825
msgid "Type must be one of: {types}"
msgstr "Type moet een van de volgende zijn: {types}"

#: commands\aircraft.py:836
msgid "Invalid ICAO Code"
msgstr "Ongeldige ICAO-code"

#: commands\aircraft.py:846
msgid "Invalid Aircraft Type"
msgstr "Ongeldig vliegtuigtype"

#: commands\aircraft.py:847
msgid "Unknown type: **{type}**\n\n"
"Available types: {types}"
msgstr "Onbekend type: **{type}**\n\n"
"Beschikbare typen: {types}"

#: commands\aircraft.py:859
msgid "Invalid Squawk Code"
msgstr "Ongeldige Squawk-code"

#: commands\aircraft.py:860
msgid "Squawk code must be 4 digits (e.g., 7700)."
msgstr "Squawk-code moet uit 4 cijfers bestaan (bijv. 7700)."

#: commands\aircraft.py:872
msgid "✅ Watchlist Updated"
msgstr "✅ Volglijst bijgewerkt"

#: commands\aircraft.py:872
msgid "❌ Error"
msgstr "❌ Fout"

#: commands\aircraft.py:899
msgid "Remove from Watchlist"
msgstr "Verwijderen van volglijst"

#: commands\aircraft.py:900
msgid "Remove aircraft or types from your watchlist."
msgstr "Verwijder vliegtuigen of typen van uw volglijst."

#: commands\aircraft.py:903
msgid "`watchlist remove <type> <value>`"
msgstr "`watchlist remove <type> <waarde>`"

#: commands\aircraft.py:906
msgid "• `icao` - Remove by aircraft hex code\n"
"• `type` - Remove aircraft type\n"
"• `callsign` - Remove by flight number\n"
"• `reg` - Remove by registration\n"
"• `squawk` - Remove by squawk code"
msgstr "• `icao` - Verwijderen op hex-code van vliegtuig\n"
"• `type` - Vliegtuigtype verwijderen\n"
"• `callsign` - Verwijderen op vluchtnummer\n"
"• `reg` - Verwijderen op registratie\n"
"• `squawk` - Verwijderen op squawk-code"

#: commands\aircraft.py:921
msgid "✅ Removed"
msgstr "✅ Verwijderd"

#: commands\aircraft.py:921
msgid "❌ Not Found"
msgstr "❌ Niet gevonden"

#: commands\aircraft.py:938 commands\aircraft.py:984
msgid "Watchlist Empty"
msgstr "Volglijst is leeg"

#: commands\aircraft.py:939
msgid "Your watchlist is empty.\n\n"
"Use `{prefix}aircraft watchlist add <type> <value>` to add items.\n\n"
"Example: `{prefix}aircraft watchlist add type military`"
msgstr "Uw volglijst is leeg.\n\n"
"Gebruik `{prefix}aircraft watchlist add <type> <waarde>` om items toe te voegen.\n\n"
"Voorbeeld: `{prefix}aircraft watchlist add type military`"

#: commands\aircraft.py:947
msgid "Your Watchlist"
msgstr "Uw volglijst"

#: commands\aircraft.py:948
msgid "You are watching **{count}** items:"
msgstr "U volgt **{count}** items:"

#: commands\aircraft.py:969
msgid "None"
msgstr "Geen"

#: commands\aircraft.py:973
msgid "Use `{prefix}aircraft watchlist status` for detailed status."
msgstr "Gebruik `{prefix}aircraft watchlist status` voor een gedetailleerde status."

#: commands\aircraft.py:985
msgid "Your watchlist is empty."
msgstr "Uw volglijst is leeg."

#: commands\aircraft.py:1012
msgid "Watchlist Status"
msgstr "Volglijststatus"

#: commands\aircraft.py:1013
msgid "**{total}** items in watchlist | **{online}** aircraft currently online"
msgstr "**{total}** items op volglijst | **{online}** vliegtuigen momenteel online"

#: commands\aircraft.py:1050
msgid "🟢 Aircraft Online"
msgstr "🟢 Vliegtuig online"

#: commands\aircraft.py:1065
msgid "Watchlist Already Empty"
msgstr "Volglijst is al leeg"

#: commands\aircraft.py:1066
msgid "Your watchlist is already empty."
msgstr "Uw volglijst is al leeg."

#: commands\aircraft.py:1079
msgid "✅ Watchlist Cleared"
msgstr "✅ Volglijst gewist"

#: commands\aircraft.py:1080
msgid "Removed **{count}** items from your watchlist."
msgstr "**{count}** items verwijderd van uw volglijst."

#: commands\aircraft.py:1099 commands\aircraft.py:1170
msgid "{seconds} seconds"
msgstr "{seconds} seconden"

#: commands\aircraft.py:1101 commands\aircraft.py:1103
#: commands\aircraft.py:1172 commands\aircraft.py:1174
msgid "{minutes} minutes"
msgstr "{minutes} minuten"

#: commands\aircraft.py:1106
msgid "Watchlist Cooldown"
msgstr "Wachttijd volglijst"

#: commands\aircraft.py:1107
msgid "Current notification cooldown: **{cooldown}**\n\n"
"Use `{prefix}aircraft watchlist cooldown <duration>` to change it.\n\n"
"Examples: `20m`, `30s`, `1h`, `15.5m`"
msgstr "Huidige meldingswachttijd: **{cooldown}**\n\n"
"Gebruik `{prefix}aircraft watchlist cooldown <tijdsduur>` om dit te wijzigen.\n\n"
"Voorbeelden: `20m`, `30s`, `1h`, `15.5m`"

#: commands\aircraft.py:1114
msgid "How it works"
msgstr "Hoe het werkt"

#: commands\aircraft.py:1115
msgid "After you receive a notification for a watched aircraft, you won't receive another notification for the same aircraft until the cooldown period expires."
msgstr "Nadat u een melding hebt ontvangen voor een gevolgd vliegtuig, ontvangt u pas weer een melding voor hetzelfde vliegtuig zodra de wachttijd is verstreken."

#: commands\aircraft.py:1119
msgid "Time formats"
msgstr "Tijdnotaties"

#: commands\aircraft.py:1120
msgid "You can use:\n"
"• Minutes: `20`, `20m`, `20.5m`\n"
"• Seconds: `30s`, `120s`\n"
"• Hours: `1h`, `2.5h`"
msgstr "U kunt gebruiken:\n"
"• Minuten: `20`, `20m`, `20.5m`\n"
"• Seconden: `30s`, `120s`\n"
"• Uur: `1h`, `2.5h`"

#: commands\aircraft.py:1149 commands\aircraft.py:1158
msgid "Invalid Cooldown"
msgstr "Ongeldige wachttijd"

#: commands\aircraft.py:1150
msgid "Cooldown must be at least 1 second."
msgstr "Wachttijd moet ten minste 1 seconde zijn."

#: commands\aircraft.py:1159
msgid "Cooldown cannot exceed 1440 minutes (24 hours)."
msgstr "Wachttijd kan niet langer zijn dan 1440 minuten (24 uur)."

#: commands\aircraft.py:1177
msgid "✅ Cooldown Updated"
msgstr "✅ Wachttijd bijgewerkt"

#: commands\aircraft.py:1178
msgid "Watchlist notification cooldown set to **{cooldown}**."
msgstr "Meldingswachttijd voor volglijst ingesteld op **{cooldown}**."

#: commands\aircraft.py:1185
msgid "Invalid Duration Format"
msgstr "Ongeldig tijdsduurformaat"

#: commands\aircraft.py:1186
msgid "Invalid duration format. Use a number (e.g. '20'), minutes ('20m'), seconds ('30s'), or hours ('1h').\n\n"
"Examples:\n"
"• `20m` - 20 minutes\n"
"• `30s` - 30 seconds\n"
"• `1h` - 1 hour\n"
"• `15.5m` - 15.5 minutes"
msgstr "Ongeldig tijdsduurformaat. Gebruik een getal (bijv. '20'), minuten ('20m'), seconden ('30s') of uren ('1h').\n\n"
"Voorbeelden:\n"
"• `20m` - 20 minuten\n"
"• `30s` - 30 seconden\n"
"• `1h` - 1 uur\n"
"• `15.5m` - 15,5 minuten"

