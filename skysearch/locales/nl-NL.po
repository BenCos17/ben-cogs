#: commands\admin.py:19
#, docstring
msgid "Admin-related commands for SkySearch."
msgstr "Gerelateerde beheercommando's voor SkySearch."

#: commands\admin.py:29
msgid "Alert channel set to {channel}"
msgstr "Waarschuwingskanaal ingesteld op {channel}"

#: commands\admin.py:37
msgid "Alert channel cleared. No more alerts will be sent."
msgstr "Waarschuwingskanaal gewist. Er worden geen waarschuwingen meer verzonden."

#: commands\admin.py:48
msgid "Alert role set to {role}"
msgstr "Waarschuwingsrol ingesteld op {role}"

#: commands\admin.py:56
msgid "Alert role cleared. No more role mentions will be made."
msgstr "Waarschuwingsrol gewist. Er worden geen rolvermeldingen meer gedaan."

