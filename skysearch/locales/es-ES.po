msgid "{seconds} seconds"
msgstr "{seconds} segundos"

#: commands\aircraft.py:1101 commands\aircraft.py:1103
#: commands\aircraft.py:1172 commands\aircraft.py:1174
msgid "{minutes} minutes"
msgstr "{minutes} minutos"

#: commands\aircraft.py:1106
msgid "Watchlist Cooldown"
msgstr "Tiempo de espera de la lista de seguimiento"

#: commands\aircraft.py:1107
msgid "Current notification cooldown: **{cooldown}**\n\n"
"Use `{prefix}aircraft watchlist cooldown <duration>` to change it.\n\n"
"Examples: `20m`, `30s`, `1h`, `15.5m`"
msgstr "Tiempo de espera actual de las notificaciones: **{cooldown}**\n\n"
"Usa `{prefix}aircraft watchlist cooldown <duration>` para cambiarlo.\n\n"
"Ejemplos: `20m`, `30s`, `1h`, `15.5m`"

#: commands\aircraft.py:1114
msgid "How it works"
msgstr "Cómo funciona"

#: commands\aircraft.py:1115
msgid "After you receive a notification for a watched aircraft, you won't receive another notification for the same aircraft until the cooldown period expires."
msgstr "Después de recibir una notificación sobre una aeronave seguida, no recibirás otra notificación sobre la misma aeronave hasta que expire el tiempo de espera."

#: commands\aircraft.py:1119
msgid "Time formats"
msgstr "Formatos de tiempo"

#: commands\aircraft.py:1120
msgid "You can use:\n"
"• Minutes: `20`, `20m`, `20.5m`\n"
"• Seconds: `30s`, `120s`\n"
"• Hours: `1h`, `2.5h`"
msgstr "Puedes usar:\n"
"• Minutos: `20`, `20m`, `20.5m`\n"
"• Segundos: `30s`, `120s`\n"
"• Horas: `1h`, `2.5h`"

#: commands\aircraft.py:1149 commands\aircraft.py:1158
msgid "Invalid Cooldown"
msgstr "Tiempo de espera no válido"

#: commands\aircraft.py:1150
msgid "Cooldown must be at least 1 second."
msgstr "El tiempo de espera debe ser de al menos 1 segundo."

#: commands\aircraft.py:1159
msgid "Cooldown cannot exceed 1440 minutes (24 hours)."
msgstr "El tiempo de espera no puede superar los 1440 minutos (24 horas)."

#: commands\aircraft.py:1177
msgid "✅ Cooldown Updated"
msgstr "✅ Tiempo de espera actualizado"

#: commands\aircraft.py:1178
msgid "Watchlist notification cooldown set to **{cooldown}**."
msgstr "El tiempo de espera de las notificaciones de la lista de seguimiento se ha establecido en **{cooldown}**."

#: commands\aircraft.py:1185
msgid "Invalid Duration Format"
msgstr "Formato de duración no válido"

#: commands\aircraft.py:1186
msgid "Invalid duration format. Use a number (e.g. '20'), minutes ('20m'), seconds ('30s'), or hours ('1h').\n\n"
"Examples:\n"
"• `20m` - 20 minutes\n"
"• `30s` - 30 seconds\n"
"• `1h` - 1 hour\n"
"• `15.5m` - 15.5 minutes"
msgstr "Formato de duración no válido. Usa un número (p. ej., '20'), minutos ('20m'), segundos ('30s') u horas ('1h').\n\n"
"Ejemplos:\n"
"• `20m` - 20 minutos\n"
"• `30s` - 30 segundos\n"
"• `1h` - 1 hora\n"
"• `15.5m` - 15,5 minutos"

