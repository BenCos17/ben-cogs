msgstr "Elimina aeronaves o tipos de tu lista de seguimiento."

#: commands\aircraft.py:903
msgid "`watchlist remove <type> <value>`"
msgstr ""

#: commands\aircraft.py:906
msgid "• `icao` - Remove by aircraft hex code\n"
"• `type` - Remove aircraft type\n"
"• `callsign` - Remove by flight number\n"
"• `reg` - Remove by registration\n"
"• `squawk` - Remove by squawk code"
msgstr "• `icao` - Eliminar por código hexadecimal de aeronave\n"
"• `type` - Eliminar tipo de aeronave\n"
"• `callsign` - Eliminar por número de vuelo\n"
"• `reg` - Eliminar por matrícula\n"
"• `squawk` - Eliminar por código squawk"

