msgstr "Lista de seguimiento vacía"

#: commands\aircraft.py:939
msgid "Your watchlist is empty.\n\n"
"Use `{prefix}aircraft watchlist add <type> <value>` to add items.\n\n"
"Example: `{prefix}aircraft watchlist add type military`"
msgstr "Tu lista de seguimiento está vacía.\n\n"
"Usa `{prefix}aircraft watchlist add <type> <value>` para añadir elementos.\n\n"
"Ejemplo: `{prefix}aircraft watchlist add type military`"

